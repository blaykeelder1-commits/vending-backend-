# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/vending_db

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=GENERATE_A_NEW_64_BYTE_BASE64_SECRET
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=GENERATE_A_NEW_64_BYTE_BASE64_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d

# QR Code Security
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
QR_ENCRYPTION_KEY=GENERATE_A_32_CHAR_HEX_STRING

# Session Configuration
SESSION_EXPIRY_HOURS=24

# Google Sheets API (for inventory integration)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Cloudinary (optional - for production image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# NEW SERVICES FOR PRODUCTION LAUNCH
# ====================================

# Upstash Redis Cache (free tier: https://upstash.com/)
# Creates ~5min cache for DB queries, reduces load significantly
# Get credentials from Upstash console after creating a Redis database
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry Error Tracking (free tier: https://sentry.io/)
# Captures and reports production errors automatically
# Get DSN from Sentry project settings after creating a project
SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# Resend Email Service (free tier: https://resend.com/)
# 3,000 free emails/month - handles welcome, onboarding, re-engagement
# Get API key from Resend dashboard
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=IDDI <noreply@yourdomain.com>

# Google OAuth (for vendor login)
# Get credentials from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application type)
# Add authorized origins: http://localhost:3000 (dev), https://yourdomain.com (prod)
# Add authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Square Subscriptions (for billing)
# Create a separate Square account for IDDI (not Sheridan Rentals)
# Get credentials from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_GROWTH_PLAN_ID=your-growth-plan-variation-id
SQUARE_PRO_PLAN_ID=your-pro-plan-variation-id
SQUARE_BUSINESS_PLAN_ID=your-business-plan-variation-id
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key
SQUARE_WEBHOOK_URL=https://your-backend.onrender.com/api/subscription/webhook

# Support email (receives ticket notifications)
SUPPORT_EMAIL=support@yourdomain.com
