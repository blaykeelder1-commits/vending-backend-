# Production Environment Variables for IDDI Backend
# Copy these to your Render dashboard under Environment Variables

# Required
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=generate-a-long-random-string-here
FRONTEND_URL=https://your-app.vercel.app

# Email (Required for emails to actually send)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=IDDI <noreply@yourdomain.com>

# Optional - Error Tracking
SENTRY_DSN=https://xxxxx@o123.ingest.sentry.io/456

# Optional - Caching (improves performance)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Rate Limiting (defaults are fine)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
